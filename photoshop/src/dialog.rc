// Tessalith DDS: the Save dialog template. MIT licence (see photoshop/LICENSE).
// Fixed layout (DC33): every control is always present. Each label comes right before its list, so it names the
// list for screen readers and its mnemonic moves focus there; a checkbox's text is its own label. Tab order is the
// order below, which is the visual order: row by row, left to right.
#include <windows.h>
#include "dialog.h"

IDD_SAVE DIALOGEX 0, 0, 206, 96
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tessalith DDS options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Texture type:", -1, 7, 9, 52, 8
    COMBOBOX        IDC_TYPE, 62, 7, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&sRGB", IDC_SRGB, 158, 8, 41, 10, WS_TABSTOP
    LTEXT           "&Format:", -1, 7, 27, 52, 8
    COMBOBOX        IDC_FORMAT, 62, 25, 137, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Mipmaps", IDC_MIPS, 7, 44, 52, 10, WS_TABSTOP
    LTEXT           "F&ilter:", -1, 62, 45, 24, 8
    COMBOBOX        IDC_FILTER, 88, 43, 111, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Quality:", -1, 7, 63, 52, 8
    COMBOBOX        IDC_QUALITY, 62, 61, 137, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 95, 77, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 149, 77, 50, 14
END
