// Tessalith DDS: the Save dialog templates. MIT licence (see photoshop/LICENSE).
// Fixed layout (DC33, DC37): every control is always present. Each label comes right before its list, so it names
// the list for screen readers and its mnemonic moves focus there; a checkbox's or button's text is its own label.
// Tab order is the order below, which is the visual order: row by row, left to right.
#include <windows.h>
#include "dialog.h"

IDD_SAVE DIALOGEX 0, 0, 250, 118
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tessalith DDS options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Preset:", -1, 7, 9, 52, 8
    COMBOBOX        IDC_PRESET, 62, 7, 82, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sa&ve preset...", IDC_PRESET_SAVE, 147, 6, 52, 14, WS_TABSTOP
    PUSHBUTTON      "&Delete", IDC_PRESET_DELETE, 202, 6, 41, 14, WS_TABSTOP
    LTEXT           "&Texture type:", -1, 7, 27, 52, 8
    COMBOBOX        IDC_TYPE, 62, 25, 85, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&sRGB", IDC_SRGB, 152, 26, 91, 10, WS_TABSTOP
    LTEXT           "&Format:", -1, 7, 45, 52, 8
    COMBOBOX        IDC_FORMAT, 62, 43, 85, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Discard t&ransparency", IDC_DISCARD, 152, 44, 91, 10, WS_TABSTOP
    AUTOCHECKBOX    "&Mipmaps", IDC_MIPS, 7, 62, 52, 10, WS_TABSTOP
    LTEXT           "F&ilter:", -1, 62, 63, 24, 8
    COMBOBOX        IDC_FILTER, 88, 61, 155, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Quality:", -1, 7, 81, 52, 8
    COMBOBOX        IDC_QUALITY, 62, 79, 181, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 139, 98, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 193, 98, 50, 14
END

IDD_PRESET_NAME DIALOGEX 0, 0, 200, 52
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save preset"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Name:", -1, 7, 9, 30, 8
    EDITTEXT        IDC_PRESET_NAME, 40, 7, 153, 12, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 89, 31, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 31, 50, 14
END
