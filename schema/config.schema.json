    "PartialProfile": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/PartialAlphaSpec"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "channels": {
          "$ref": "#/$defs/PartialChannelSpec"
        },
        "color": {
          "$ref": "#/$defs/PartialColorSpec"
        },
        "encoder": {
          "$ref": "#/$defs/PartialEncoderSpec"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "header": {
          "$ref": "#/$defs/HeaderForm"
        },
        "mips": {
          "$ref": "#/$defs/PartialMipSpec"
        },
        "packing": {
          "$ref": "#/$defs/PartialPackingSpec"
        },
        "resize": {
          "$ref": "#/$defs/ResizeMode",
          "description": "Preprocess step 6 (spec §5.4); `pot-down` = largest power of two ≤ each axis."
        },
        "subtype": {
          "$ref": "#/$defs/Subtype"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "validation": {
          "$ref": "#/$defs/PartialValidationSpec"
        }
      },
      "type": "object"
    },
    "PartialValidationSpec": {
      "additionalProperties": false,
      "properties": {
        "bc6h_min_peak_ratio": {
          "format": "double",
          "type": "number"
        },
        "complex_m_warn_alpha": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "coverage_tolerance_pts": {
          "format": "double",
          "type": "number"
        },
        "min_mip_psnr_db": {
          "format": "double",
          "type": "number"
        },
        "pgpatcher_non_white_share": {
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/AlphaSpec"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "channels": {
          "$ref": "#/$defs/ChannelSpec"
        },
        "color": {
          "$ref": "#/$defs/ColorSpec"
        },
        "encoder": {
          "$ref": "#/$defs/EncoderSpec"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "header": {
          "$ref": "#/$defs/HeaderForm"
        },
        "mips": {
          "$ref": "#/$defs/MipSpec"
        },
        "packing": {
          "$ref": "#/$defs/PackingSpec"
        },
        "resize": {
          "$ref": "#/$defs/ResizeMode",
          "description": "Preprocess step 6 (spec §5.4); `pot-down` = largest power of two ≤ each axis."
        },
        "subtype": {
          "$ref": "#/$defs/Subtype"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "validation": {
          "$ref": "#/$defs/ValidationSpec"
        }
      },
      "required": [
        "target",
        "category",
        "subtype",
        "color",
        "alpha",
        "channels",
        "mips",
        "format",
        "header",
        "encoder",
        "validation",
        "packing"
      ],
      "type": "object"
    },
    "ResizeMode": {
      "enum": [
        "none",
        "pot-down"
      ],
      "type": "string"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/RuleMatch"
        },
        "overrides": {
          "$ref": "#/$defs/PartialProfile",
          "default": null
        },
        "subtype": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subtype"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "match"
      ],
      "type": "object"
    },
    "RuleMatch": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlphaContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "glob": {
          "default": null,
          "description": "Glob over the game-relative path (lower case, '/'), e.g. \"**/armor/**/*_n.png\".",
          "type": [
            "string",
            "null"
          ]
        },
        "set_has": {
          "default": null,
