        "complex_m_warn_alpha": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "coverage_tolerance_pts": {
          "format": "double",
          "type": "number"
        },
        "min_mip_psnr_db": {
          "format": "double",
          "type": "number"
        },
        "mips": {
          "$ref": "#/$defs/ValidationMips",
          "description": "M6 Track D (DECISIONS Notes T5, Y6): `smallest` runs the per-mip PSNR check on the smallest mip only and the\ncoverage check on every level (`fast-preview`). Not serialised at its default, so existing profile hashes hold."
        },
        "pgpatcher_non_white_share": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
