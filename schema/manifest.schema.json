{
  "$defs": {
    "AlphaCompare": {
      "enum": [
        "gt",
        "ge"
      ],
      "type": "string"
    },
    "AlphaPolicy": {
      "enum": [
        "remove",
        "cutout",
        "blend",
        "cutout_blend",
        "data"
      ],
      "type": "string"
    },
    "AlphaSpec": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "$ref": "#/$defs/AlphaCompare"
        },
        "exact_opaque": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/AlphaPolicy"
        },
        "threshold": {
          "description": "8-bit alpha-test threshold, per texture; allowed 1..=254 (checked in policy).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "threshold",
        "compare",
        "exact_opaque"
      ],
      "type": "object"
    },
    "AlphaStats": {
      "description": "Counts of decoded alpha values over one image.",
      "properties": {
        "below254": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eq254": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eq255": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "min": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "pixels": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pixels",
        "eq255",
        "eq254",
        "below254",
        "min"
      ],
      "type": "object"
    },
    "Backend": {
      "enum": [
        "bc7e",
        "rgbcx",
        "ispc_bc6h",
        "nvtt",
        "uncompressed"
      ],
      "type": "string"
    },
    "BentMode": {
      "enum": [
        "ao_blend",
        "detail"
      ],
      "type": "string"
    },
    "BentSpec": {
      "additionalProperties": false,
      "description": "The `bent` layer: a layer plus its AO-blend settings (F2 spec §3.1, §3.3).",
      "properties": {
        "ao": {
          "description": "Read the AO source; `false` = a uniform weight.",
          "type": "boolean"
        },
        "ao_power": {
          "description": "The power on the occlusion `1 − AO`; `None` = 1.5.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "flip_green": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mask": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/BentMode"
        },
        "strength": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Category": {
      "enum": [
        "color",
        "normal",
        "mixed_packed",
        "grayscale",
        "hdr"
      ],
      "type": "string"
    },
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "flip_green": {
          "type": "boolean"
        },
        "grayscale_source": {
          "$ref": "#/$defs/GraySource"
        },
        "green_convention": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenConvention"
            },
            {
              "type": "null"
            }
          ],
          "description": "Green (Y) convention of a normal source (spec §3.2, §4.4, DECISIONS Note H); None = unstated.\n`opengl` makes Resolve set `flip_green`."
        },
        "reconstruct_z": {
          "type": "boolean"
        },
        "swizzle": {
          "default": null,
          "description": "Four characters from r, g, b, a, 0, 1 (e.g. \"bgra\", \"rrr1\"); None = identity.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "flip_green",
        "reconstruct_z",
        "grayscale_source"
      ],
      "type": "object"
    },
    "ColorContent": {
      "enum": [
        "srgb",
        "linear"
      ],
      "type": "string"
    },
    "ColorSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/ColorContent"
        },
        "tag": {
          "$ref": "#/$defs/ColorTag"
        }
      },
      "required": [
        "content",
        "tag"
      ],
      "type": "object"
    },
    "ColorTag": {
      "enum": [
        "srgb",
        "unorm",
        "n/a"
      ],
      "type": "string"
    },
    "CoverageMode": {
      "enum": [
        "auto",
        "on",
        "off"
      ],
      "type": "string"
    },
    "Effort": {
      "enum": [
        "ultrafast",
        "veryfast",
        "fast",
        "basic",
        "veryslow",
        "slowest"
      ],
      "type": "string"
    },
    "EncoderSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "bc1_transparent_black": {
          "type": "boolean"
        },
        "bc45_search_radius": {
          "$ref": "#/$defs/SearchRadius"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "perceptual": {
          "type": "boolean"
        },
        "rgbcx_level": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "backend",
        "effort",
        "rgbcx_level",
        "perceptual",
        "bc1_transparent_black",
        "bc45_search_radius"
      ],
      "type": "object"
    },
    "EncoderVersions": {
      "properties": {
        "bc7e_patch": {
          "description": "`<patch name>@sha256:<hash of the patch file>`; `None` when the vendored bc7e is unpatched.",
          "type": [
            "string",
            "null"
          ]
        },
        "bc7enc_rdo": {
          "type": "string"
        },
        "ispc": {
          "type": "string"
        },
        "ispctc": {
          "type": "string"
        },
        "nvtt": {
          "description": "M5 (DECISIONS Note NV10): the NVTT version that encoded this output; only on records of a profile on\n`encoder.backend = \"nvtt\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rgbcx_patch": {
          "description": "`<patch name>@sha256:<hash of the patched rgbcx.h>`; `None` before the patch, so BC3/BC4/BC5 re-encode.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bc7enc_rdo",
        "ispctc",
        "ispc"
      ],
      "type": "object"
    },
    "FillSpec": {
      "additionalProperties": false,
      "description": "Global fill values for packed channels without a source map (spec §6.4, DECISIONS Notes H and M5): an 8-bit\ncode per §4.4 raw-map role, `None` = the neutral default. Unset fills are not serialised.",
      "properties": {
        "ao": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fuzz": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "glossiness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metallic": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "opacity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "roughness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "specular": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Format": {
      "enum": [
        "bc1",
        "bc3",
        "bc4",
        "bc5",
        "bc6h_uf16",
        "bc7",
        "rgba8",
        "r8",
        "rg8",
        "rgba16f"
      ],
      "type": "string"
    },
    "GraySource": {
      "enum": [
        "r",
        "luma"
      ],
      "type": "string"
    },
    "GreenConvention": {
      "enum": [
        "directx",
        "opengl"
      ],
      "type": "string"
    },
    "HeaderForm": {
      "enum": [
        "auto",
        "dx10",
        "legacy"
      ],
      "type": "string"
    },
    "LayerId": {
      "description": "One RNM normal layer (M6 Track F2 spec §2.1).",
      "enum": [
        "bump",
        "bump2",
        "detail",
        "detail2",
        "bent"
      ],
      "type": "string"
    },
    "LayerSpec": {
      "additionalProperties": false,
      "description": "One layer's settings (F2 spec §4). Every field is optional at its default: `strength` = the layer's\n`default_strength`, `flip_green` = the base's own `channels.flip_green`, `mask` = on when the mask file exists.",
      "properties": {
        "flip_green": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mask": {
          "type": "boolean"
        },
        "strength": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MipEdge": {
      "enum": [
        "wrap",
        "clamp"
      ],
      "type": "string"
    },
    "MipFilter": {
      "enum": [
        "box",
        "tent",
        "mitchell",
        "kaiser"
      ],
      "type": "string"
    },
    "MipKeyword": {
      "enum": [
        "full",
        "none"
      ],
      "type": "string"
    },
    "MipLevels": {
      "anyOf": [
        {
          "$ref": "#/$defs/MipKeyword"
        },
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "MipSpec": {
      "additionalProperties": false,
      "properties": {
        "bake_clamp": {
          "default": 0.25,
          "description": "Clamp `t` of the variance bake (spec §6.2, DECISIONS Note E): the added variance is at most `t²`. 0.25;\nallowed (0, 1]. Read from the profile the bake writes into: a roughness member, or a `_cnr`.",
          "format": "double",
          "type": "number"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageMode",
          "description": "Coverage preservation (spec §5.5). It only ever applies to the alpha-tested policies `cutout` and\n`cutout_blend`: `auto` and `on` both enable it there, `off` disables it, and on any other policy (`blend`,\n`data`, `remove`) every mode is a no-op, because blended alpha must keep box-averaged opacity."
        },
        "edge": {
          "$ref": "#/$defs/MipEdge",
          "description": "Edge handling of the mip filter taps: read only by tent, Mitchell and Kaiser (spec §3.2)."
        },
        "filter": {
          "$ref": "#/$defs/MipFilter"
        },
        "levels": {
          "$ref": "#/$defs/MipLevels"
        },
        "normal": {
          "$ref": "#/$defs/NormalMips"
        },
        "normal_base": {
          "$ref": "#/$defs/NormalBase",
          "default": "renormalize",
          "description": "Mip 0 of a normal map (spec §5.4, DECISIONS R1): `renormalize` (default) stores every base vector at unit\nlength; `keep` stores the source as authored. Read only for the Normal category."
        }
      },
      "required": [
        "levels",
        "filter",
        "normal",
        "coverage"
      ],
      "type": "object"
    },
    "NormalBase": {
      "enum": [
        "renormalize",
        "keep"
      ],
      "type": "string"
    },
    "NormalMips": {
      "enum": [
        "renormalize",
        "renormalize_bake"
      ],
      "type": "string"
    },
    "PackPrefer": {
      "enum": [
        "prepacked",
        "raw"
      ],
      "type": "string"
    },
    "PackRecipe": {
      "description": "Which cs recipe a set packs (DECISIONS Note R-fills-1): `auto` = `_rfaos` when a fuzz source exists, else\n`_rmaos`; `rfaos`/`rmaos` force one.",
      "enum": [
        "auto",
        "rmaos",
        "rfaos"
      ],
      "type": "string"
    },
    "PackingSpec": {
      "additionalProperties": false,
      "description": "Channel-packing settings (spec §3.2, §6.4). Fields of the packed output's profile, resolved like any other.",
      "properties": {
        "enabled": {
          "description": "Pack this output's recipe; `false` leaves its raw maps as packing inputs (`IN-PACKING-INPUT`).",
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/FillSpec",
          "default": {}
        },
        "prefer": {
          "$ref": "#/$defs/PackPrefer",
          "description": "Which side wins when the set already holds the packed output as a file (`PACK-CONFLICT`)."
        },
        "recipe": {
          "$ref": "#/$defs/PackRecipe",
          "description": "Which cs recipe this set packs (`auto`, `rmaos`, `rfaos`; DECISIONS Note R-fills-1). Set per set at either packed key,\n`[files.\"<folder/base>_rfaos\"]` or `..._rmaos\"]`."
        },
        "roughness_default": {
          "description": "Neutral roughness (0..=1) for a channel without a roughness or glossiness source.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "roughness_default",
        "prefer"
      ],
      "type": "object"
    },
    "PresetRef": {
      "description": "The preset that resolved a file. For a file matched by a suffix alias this is the alias preset (the one\n`policy::preset_for` returns), with `alias_chain` holding its full inheritance chain, root base first, so a\nreader can tell which presets contributed. Empty for a file resolved by the batch preset's own chain.",
      "properties": {
        "alias_chain": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/AlphaSpec"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "channels": {
          "$ref": "#/$defs/ChannelSpec"
        },
        "color": {
          "$ref": "#/$defs/ColorSpec"
        },
        "encoder": {
          "$ref": "#/$defs/EncoderSpec"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "header": {
          "$ref": "#/$defs/HeaderForm"
        },
        "mips": {
          "$ref": "#/$defs/MipSpec"
        },
        "packing": {
          "$ref": "#/$defs/PackingSpec"
        },
        "resize": {
          "$ref": "#/$defs/ResizeMode",
          "description": "Preprocess step 6 (spec §5.4); `pot-down` = largest power of two ≤ each axis, `half` = both axes halved when the larger is above 512 (M6 Track D)."
        },
        "rnm": {
          "$ref": "#/$defs/RnmSpec",
          "description": "RNM normal layers (M6 Track F2); read only by base normals (`Subtype::rnm_base`)."
        },
        "subtype": {
          "$ref": "#/$defs/Subtype"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "validation": {
          "$ref": "#/$defs/ValidationSpec"
        }
      },
      "required": [
        "target",
        "category",
        "subtype",
        "color",
        "alpha",
        "channels",
        "mips",
        "format",
        "header",
        "encoder",
        "validation",
        "packing"
      ],
      "type": "object"
    },
    "Provenance": {
      "description": "Where a resolved field value came from (spec §5.2). Declaration order is precedence order, lowest first.\n\nSerialises as a string: `builtin`, `preset:<id>`, `rule:<source>#<n>` (the `Rule` payload is the\n`<source>#<n>` part), `analysis:<fact>`, `shader:<id>`, `mesh:alpha`, `suffix:<term>`, `source:<file>`,\n`default:<value>`, `fill:<code>`, `recipe:<kind>`, and the snake_case variant name for the rest.",
      "type": "string"
    },
    "RawMap": {
      "enum": [
        "roughness",
        "metallic",
        "ao",
        "specular",
        "glossiness",
        "height",
        "opacity",
        "fuzz"
      ],
      "type": "string"
    },
    "ResizeMode": {
      "enum": [
        "none",
        "pot-down",
        "half"
      ],
      "type": "string"
    },
    "RnmSpec": {
      "additionalProperties": false,
      "description": "RNM normal layers (M6 Track F2 spec §4). A field of every profile, read only by base normals (`Subtype::rnm_base`);\nnot serialised at its default, so profile hashes written before F2 hold (DECISIONS Note W6).",
      "properties": {
        "bent": {
          "$ref": "#/$defs/BentSpec"
        },
        "bump": {
          "$ref": "#/$defs/LayerSpec"
        },
        "bump2": {
          "$ref": "#/$defs/LayerSpec"
        },
        "detail": {
          "$ref": "#/$defs/LayerSpec"
        },
        "detail2": {
          "$ref": "#/$defs/LayerSpec"
        },
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "description": "Blend order; see [`RnmSpec::effective_order`].",
          "items": {
            "$ref": "#/$defs/LayerId"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SearchRadius": {
      "enum": [
        "default",
        "max",
        "fast"
      ],
      "type": "string"
    },
    "Shader": {
      "description": "A Skyrim shader a texture set is made for (spec §3).",
      "enum": [
        "pbr",
        "pbr_grass",
        "advanced_skin",
        "default",
        "envmap",
        "complex_material",
        "glow",
        "parallax",
        "skin",
        "hair",
        "eye",
        "multilayer",
        "landscape",
        "complex_grass"
      ],
      "type": "string"
    },
    "ShaderOrigin": {
      "description": "Why a set has its shader (spec §4.4). Serialises as a string: `set`, `auto:<rule id>`, `fallback`.",
      "type": "string"
    },
    "ShaderPick": {
      "description": "A set's shader, why it was chosen, and the shader asked for when that one was not available (`wanted`).",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/ShaderOrigin"
        },
        "shader": {
          "$ref": "#/$defs/Shader"
        },
        "wanted": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shader"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shader",
        "provenance"
      ],
      "type": "object"
    },
    "SourceRef": {
      "description": "One source file of a record: its path and SHA-256. A recipe built from several sources (`_rmaos`, `_p`) lists\nthem all so `if-changed` can re-encode when any of them changes.",
      "properties": {
        "bake": {
          "description": "The `_n` a roughness member baked its variance from (DECISIONS R12): the SHA-256 of its decode settings and\nlevel shift (`BakeJob::identity_sha256`). Absent on every other source.",
          "type": [
            "string",
            "null"
          ]
        },
        "invert": {
          "description": "The source is stored inverted (a gloss map in a roughness channel).",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "rnm": {
          "description": "M6 Track F2: an RNM input of a base normal and its role (`detail`, `detail.mask`, `bent.ao.r`, `bent.ao.b`). Absent on\nevery other source.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "The raw-map role this source fills in a packed output (DECISIONS N7). Absent in schema-1 records."
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "SourceStamp": {
      "description": "A source file's size and modification time, to tell whether it changed between planning and conversion.",
      "properties": {
        "mtime_ns": {
          "description": "Nanoseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "mtime_ns"
      ],
      "type": "object"
    },
    "Subtype": {
      "description": "A texture sub-type. `rfaos` is a deprecated alias of `skin_rfaos`: it still loads and is written back as `skin_rfaos`.",
      "enum": [
        "diffuse",
        "landscape_diffuse",
        "pbr_albedo",
        "pbr_emissive",
        "glow",
        "pbr_subsurface",
        "pbr_fuzz",
        "subsurface_tint",
        "backlight_tint",
        "ui_sky",
        "normal",
        "landscape_normal",
        "pbr_normal",
        "msn",
        "coat_normal",
        "envmask",
        "complex_material",
        "rmaos",
        "skin_rfaos",
        "flow",
        "height",
        "msn_specular",
        "generic_two_channel",
        "generic_data",
        "hdr_sky",
        "skin_albedo",
        "skin_sk",
        "skin_wet",
        "complex_grass",
        "rfaos"
      ],
      "type": "string"
    },
    "Target": {
      "enum": [
        "cs",
        "cpm",
        "vanilla"
      ],
      "type": "string"
    },
    "ValidationMips": {
      "enum": [
        "all",
        "smallest"
      ],
      "type": "string"
    },
    "ValidationSpec": {
      "additionalProperties": false,
