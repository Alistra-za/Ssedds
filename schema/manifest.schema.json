            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "levels": {
          "description": "The header's mip count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min_mip_psnr_db": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "passed": {
          "description": "No `Error`-severity warning.",
          "type": "boolean"
        }
      },
      "required": [
