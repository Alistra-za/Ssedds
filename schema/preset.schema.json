{
  "$defs": {
    "AlphaCompare": {
      "enum": [
        "gt",
        "ge"
      ],
      "type": "string"
    },
    "AlphaContent": {
      "enum": [
        "none",
        "constant255",
        "varying"
      ],
      "type": "string"
    },
    "AlphaPolicy": {
      "enum": [
        "remove",
        "cutout",
        "blend",
        "cutout_blend",
        "data"
      ],
      "type": "string"
    },
    "AlphaSpec": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "$ref": "#/$defs/AlphaCompare"
        },
        "exact_opaque": {
          "type": "boolean"
        },
        "exr_straight": {
          "description": "An OpenEXR source with alpha is straight alpha, read as stored: no un-premultiply on load (trace-debug #30,\nNote BQ15). Off: RGB / A, as OpenEXR stores premultiplied colour. Read only for an `.exr` source with alpha.",
          "type": "boolean"
        },
        "parallax": {
          "description": "`complex_material` only (DECISIONS AH2): `false` writes alpha 0 at every mip (complex material on, parallax\noff); `true` keeps the source alpha as height. Resolve sets it from the source alpha; `None` elsewhere.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "policy": {
          "$ref": "#/$defs/AlphaPolicy"
        },
        "threshold": {
          "description": "8-bit alpha-test threshold, per texture; allowed 1..=254 (checked in policy).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "threshold",
        "compare",
        "exact_opaque"
      ],
      "type": "object"
    },
    "Backend": {
      "enum": [
        "bc7e",
        "rgbcx",
        "ispc_bc6h",
        "nvtt",
        "uncompressed"
      ],
      "type": "string"
    },
    "Bc7Weights": {
      "enum": [
        "linear",
        "alpha2",
        "alpha8",
        "alpha16",
        "rmaos"
      ],
      "type": "string"
    },
    "BentMode": {
      "enum": [
        "ao_blend",
        "detail"
      ],
      "type": "string"
    },
    "BentSpec": {
      "additionalProperties": false,
      "description": "The `bent` layer: a layer plus its AO-blend settings (F2 spec §3.1, §3.3).",
      "properties": {
        "ao": {
          "description": "Read the AO source; `false` = a uniform weight.",
          "type": "boolean"
        },
        "ao_power": {
          "description": "The power on the occlusion `1 − AO`; `None` = 1.5.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "flip_green": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mask": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/BentMode"
        },
        "strength": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Category": {
      "enum": [
        "color",
        "normal",
        "mixed_packed",
        "grayscale",
        "hdr"
      ],
      "type": "string"
    },
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "flip_green": {
          "type": "boolean"
        },
        "grayscale_source": {
          "$ref": "#/$defs/GraySource"
        },
        "green_convention": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenConvention"
            },
            {
              "type": "null"
            }
          ],
          "description": "Green (Y) convention of a normal source (spec §3.2, §4.4, DECISIONS Note H); None = unstated.\n`opengl` makes Resolve set `flip_green`."
        },
        "reconstruct_z": {
          "type": "boolean"
        },
        "swizzle": {
          "default": null,
          "description": "Four characters from r, g, b, a, 0, 1 (e.g. \"bgra\", \"rrr1\"); None = identity.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "flip_green",
        "reconstruct_z",
        "grayscale_source"
      ],
      "type": "object"
    },
    "ColorContent": {
      "enum": [
        "srgb",
        "linear"
      ],
      "type": "string"
    },
    "ColorSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/ColorContent"
        },
        "tag": {
          "$ref": "#/$defs/ColorTag"
        }
      },
      "required": [
        "content",
        "tag"
      ],
      "type": "object"
    },
    "ColorTag": {
      "enum": [
        "srgb",
        "unorm",
        "n/a"
      ],
      "type": "string"
    },
    "CoverageMode": {
      "enum": [
        "auto",
        "on",
        "off"
      ],
      "type": "string"
    },
    "Effort": {
      "enum": [
        "ultrafast",
        "veryfast",
        "fast",
        "basic",
        "veryslow",
        "slowest",
        "max"
      ],
      "type": "string"
    },
    "EncoderSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "bc1_transparent_black": {
          "type": "boolean"
        },
        "bc45_search_radius": {
          "$ref": "#/$defs/SearchRadius"
        },
        "bc7_weights": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bc7Weights"
            },
            {
              "type": "null"
            }
          ],
          "description": "BC7 linear error weights (bc7e only; ignored when `perceptual` is on). Not serialised when unset, so existing\nprofile hashes hold (DECISIONS Note CP)."
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "perceptual": {
          "type": "boolean"
        },
        "rgbcx_level": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "backend",
        "effort",
        "rgbcx_level",
        "perceptual",
        "bc1_transparent_black",
        "bc45_search_radius"
      ],
      "type": "object"
    },
    "FillSpec": {
      "additionalProperties": false,
      "description": "Global fill values for packed channels without a source map (spec §6.4, DECISIONS Notes H and M5): an 8-bit\ncode per §4.4 raw-map role, `None` = the neutral default. Unset fills are not serialised.",
      "properties": {
        "ao": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fuzz": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "glossiness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metallic": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "opacity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "roughness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "specular": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Format": {
      "enum": [
        "bc1",
        "bc3",
        "bc4",
        "bc5",
        "bc6h_uf16",
        "bc7",
        "rgba8",
        "r8",
        "rg8",
        "rgba16f"
      ],
      "type": "string"
    },
    "GraySource": {
      "enum": [
        "r",
        "luma"
      ],
      "type": "string"
    },
    "GreenConvention": {
      "enum": [
        "directx",
        "opengl"
      ],
      "type": "string"
    },
    "HeaderForm": {
      "enum": [
        "auto",
        "dx10",
        "legacy"
      ],
      "type": "string"
    },
    "LayerId": {
      "description": "One RNM normal layer (M6 Track F2 spec §2.1).",
      "enum": [
        "bump",
        "bump2",
        "detail",
        "detail2",
        "bent"
      ],
      "type": "string"
    },
    "LayerSpec": {
      "additionalProperties": false,
      "description": "One layer's settings (F2 spec §4). Every field is optional at its default: `strength` = the layer's\n`default_strength`, `flip_green` = the base's own `channels.flip_green`, `mask` = on when the mask file exists.",
      "properties": {
        "flip_green": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mask": {
          "type": "boolean"
        },
        "strength": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MipEdge": {
      "enum": [
        "wrap",
        "clamp"
      ],
      "type": "string"
    },
    "MipFilter": {
      "enum": [
        "box",
        "tent",
        "mitchell",
        "kaiser"
      ],
      "type": "string"
    },
    "MipKeyword": {
      "enum": [
        "full",
        "none"
      ],
      "type": "string"
    },
    "MipLevels": {
      "anyOf": [
        {
          "$ref": "#/$defs/MipKeyword"
        },
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "MipSpec": {
      "additionalProperties": false,
      "properties": {
        "bake_clamp": {
          "default": 0.25,
          "description": "Clamp `t` of the variance bake (spec §6.2, DECISIONS Note E): the added variance is at most `t²`. 0.25;\nallowed (0, 1]. Read from the profile the bake writes into: a roughness member, or a `_cnr`.",
          "format": "double",
          "type": "number"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageMode",
          "description": "Coverage preservation (spec §5.5). It only ever applies to the alpha-tested policies `cutout` and\n`cutout_blend`: `auto` and `on` both enable it there, `off` disables it, and on any other policy (`blend`,\n`data`, `remove`) every mode is a no-op, because blended alpha must keep box-averaged opacity."
        },
        "edge": {
          "$ref": "#/$defs/MipEdge",
          "description": "Edge handling of the mip filter taps: read only by tent, Mitchell and Kaiser (spec §3.2)."
        },
        "filter": {
          "$ref": "#/$defs/MipFilter"
        },
        "levels": {
          "$ref": "#/$defs/MipLevels"
        },
        "normal": {
          "$ref": "#/$defs/NormalMips"
        },
        "normal_base": {
          "$ref": "#/$defs/NormalBase",
          "default": "renormalize",
          "description": "Mip 0 of a normal map (spec §5.4, DECISIONS R1): `renormalize` (default) stores every base vector at unit\nlength; `keep` stores the source as authored. Read only for the Normal category."
        }
      },
      "required": [
        "levels",
        "filter",
        "normal",
        "coverage"
      ],
      "type": "object"
    },
    "NormalBase": {
      "enum": [
        "renormalize",
        "keep"
      ],
      "type": "string"
    },
    "NormalMips": {
      "enum": [
        "renormalize",
        "renormalize_bake"
      ],
      "type": "string"
    },
    "PackPrefer": {
      "enum": [
        "prepacked",
        "raw"
      ],
      "type": "string"
    },
    "PackRecipe": {
      "description": "Which cs recipe a set packs (DECISIONS Note R-fills-1): `auto` = `_rfaos` when a fuzz source exists, else\n`_rmaos`; `rfaos`/`rmaos` force one.",
      "enum": [
        "auto",
        "rmaos",
        "rfaos"
      ],
      "type": "string"
    },
    "PackingSpec": {
      "additionalProperties": false,
      "description": "Channel-packing settings (spec §3.2, §6.4). Fields of the packed output's profile, resolved like any other.",
      "properties": {
        "enabled": {
          "description": "Pack this output's recipe; `false` leaves its raw maps as packing inputs (`IN-PACKING-INPUT`).",
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/FillSpec",
          "default": {}
        },
        "prefer": {
          "$ref": "#/$defs/PackPrefer",
          "description": "Which side wins when the set already holds the packed output as a file (`PACK-CONFLICT`)."
        },
        "recipe": {
          "$ref": "#/$defs/PackRecipe",
          "description": "Which cs recipe this set packs (`auto`, `rmaos`, `rfaos`; DECISIONS Note R-fills-1). Set per set at either packed key,\n`[files.\"<folder/base>_rfaos\"]` or `..._rmaos\"]`."
        },
        "roughness_default": {
          "description": "Neutral roughness (0..=1) for a channel without a roughness or glossiness source.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "roughness_default",
        "prefer"
      ],
      "type": "object"
    },
    "PartialAlphaSpec": {
      "additionalProperties": false,
