{
  "$defs": {
    "AlphaCompare": {
      "enum": [
        "gt",
        "ge"
      ],
      "type": "string"
    },
    "AlphaContent": {
      "enum": [
        "none",
        "constant255",
        "varying"
      ],
      "type": "string"
    },
    "AlphaPolicy": {
      "enum": [
        "remove",
        "cutout",
        "blend",
        "cutout_blend",
        "data"
      ],
      "type": "string"
    },
    "AlphaSpec": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "$ref": "#/$defs/AlphaCompare"
        },
        "exact_opaque": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/AlphaPolicy"
        },
        "threshold": {
          "description": "8-bit alpha-test threshold, per texture; allowed 5..=200 (checked in policy).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "threshold",
        "compare",
        "exact_opaque"
      ],
      "type": "object"
    },
    "Backend": {
      "enum": [
        "bc7e",
        "rgbcx",
        "ispc_bc6h",
        "nvtt"
      ],
      "type": "string"
    },
    "Category": {
      "enum": [
        "color",
        "normal",
        "mixed_packed",
        "grayscale",
        "hdr"
      ],
      "type": "string"
    },
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "flip_green": {
          "type": "boolean"
        },
        "grayscale_source": {
          "$ref": "#/$defs/GraySource"
        },
        "green_convention": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenConvention"
            },
            {
              "type": "null"
            }
          ],
          "description": "Green (Y) convention of a normal source (spec §3.2, §4.4, DECISIONS Note H); None = unstated.\n`opengl` makes Resolve set `flip_green`."
        },
        "reconstruct_z": {
          "type": "boolean"
        },
        "swizzle": {
          "default": null,
          "description": "Four characters from r, g, b, a, 0, 1 (e.g. \"bgra\", \"rrr1\"); None = identity.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "flip_green",
        "reconstruct_z",
        "grayscale_source"
      ],
      "type": "object"
    },
    "ColorContent": {
      "enum": [
        "srgb",
        "linear"
      ],
      "type": "string"
    },
    "ColorSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/ColorContent"
        },
        "tag": {
          "$ref": "#/$defs/ColorTag"
        }
      },
      "required": [
        "content",
        "tag"
      ],
      "type": "object"
    },
    "ColorTag": {
      "enum": [
        "srgb",
        "unorm",
        "n/a"
      ],
      "type": "string"
    },
    "CoverageMode": {
      "enum": [
        "auto",
        "on",
        "off"
      ],
      "type": "string"
    },
    "Effort": {
      "enum": [
        "ultrafast",
        "veryfast",
        "fast",
        "basic",
        "veryslow",
        "slowest"
      ],
      "type": "string"
    },
    "EncoderSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "bc1_transparent_black": {
          "type": "boolean"
        },
        "bc45_search_radius": {
          "$ref": "#/$defs/SearchRadius"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "perceptual": {
          "type": "boolean"
        },
        "rgbcx_level": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "backend",
        "effort",
        "rgbcx_level",
        "perceptual",
        "bc1_transparent_black",
        "bc45_search_radius"
      ],
      "type": "object"
    },
    "FillSpec": {
      "additionalProperties": false,
      "description": "Global fill values for packed channels without a source map (spec §6.4, DECISIONS Notes H and M5): an 8-bit\ncode per §4.4 raw-map role, `None` = the neutral default. Unset fills are not serialised.",
      "properties": {
        "ao": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fuzz": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "glossiness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metallic": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "opacity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "roughness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "specular": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Format": {
      "enum": [
        "bc1",
        "bc3",
        "bc4",
        "bc5",
        "bc6h_uf16",
        "bc7"
      ],
      "type": "string"
    },
    "GraySource": {
      "enum": [
        "r",
        "luma"
      ],
      "type": "string"
    },
    "GreenConvention": {
      "enum": [
        "directx",
        "opengl"
      ],
      "type": "string"
    },
    "HeaderForm": {
      "enum": [
        "auto",
        "dx10",
        "legacy"
      ],
      "type": "string"
    },
    "MipFilter": {
      "enum": [
        "box"
      ],
      "type": "string"
    },
    "MipKeyword": {
      "enum": [
        "full",
        "none"
      ],
      "type": "string"
    },
    "MipLevels": {
      "anyOf": [
        {
          "$ref": "#/$defs/MipKeyword"
        },
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "MipSpec": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageMode",
          "description": "Coverage preservation (spec §5.5). It only ever applies to the alpha-tested policies `cutout` and\n`cutout_blend`: `auto` and `on` both enable it there, `off` disables it, and on any other policy (`blend`,\n`data`, `remove`) every mode is a no-op, because blended alpha must keep box-averaged opacity."
        },
        "filter": {
          "$ref": "#/$defs/MipFilter"
        },
        "levels": {
          "$ref": "#/$defs/MipLevels"
        },
        "normal": {
          "$ref": "#/$defs/NormalMips"
        }
      },
      "required": [
        "levels",
        "filter",
        "normal",
        "coverage"
      ],
      "type": "object"
    },
    "NormalMips": {
      "enum": [
        "renormalize",
        "renormalize_bake"
      ],
      "type": "string"
    },
    "PackPrefer": {
      "enum": [
        "prepacked",
        "raw"
      ],
      "type": "string"
    },
    "PackRecipe": {
      "description": "Which cs recipe a set packs (DECISIONS Note R-fills-1): `auto` = `_rfaos` when a fuzz source exists, else\n`_rmaos`; `rfaos`/`rmaos` force one.",
      "enum": [
        "auto",
        "rmaos",
        "rfaos"
      ],
      "type": "string"
    },
    "PackingSpec": {
      "additionalProperties": false,
      "description": "Channel-packing settings (spec §3.2, §6.4). Fields of the packed output's profile, resolved like any other.",
      "properties": {
        "enabled": {
          "description": "Pack this output's recipe; `false` leaves its raw maps as packing inputs (`IN-PACKING-INPUT`).",
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/FillSpec",
          "default": {}
        },
        "prefer": {
          "$ref": "#/$defs/PackPrefer",
          "description": "Which side wins when the set already holds the packed output as a file (`PACK-CONFLICT`)."
        },
        "recipe": {
          "$ref": "#/$defs/PackRecipe",
          "description": "Which cs recipe this set packs (`auto`, `rmaos`, `rfaos`; DECISIONS Note R-fills-1). Set per set at either packed key,\n`[files.\"<folder/base>_rfaos\"]` or `..._rmaos\"]`."
        },
        "roughness_default": {
          "description": "Neutral roughness (0..=1) for a channel without a roughness or glossiness source.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "roughness_default",
        "prefer"
      ],
      "type": "object"
    },
    "PartialAlphaSpec": {
      "additionalProperties": false,
      "properties": {
        "compare": {
          "$ref": "#/$defs/AlphaCompare"
        },
        "exact_opaque": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/AlphaPolicy"
        },
        "threshold": {
          "description": "8-bit alpha-test threshold, per texture; allowed 5..=200 (checked in policy).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PartialChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "flip_green": {
          "type": "boolean"
        },
        "grayscale_source": {
          "$ref": "#/$defs/GraySource"
        },
        "green_convention": {
          "anyOf": [
            {
              "$ref": "#/$defs/GreenConvention"
            },
            {
              "type": "null"
            }
          ],
          "description": "Green (Y) convention of a normal source (spec §3.2, §4.4, DECISIONS Note H); None = unstated.\n`opengl` makes Resolve set `flip_green`."
        },
        "reconstruct_z": {
          "type": "boolean"
        },
        "swizzle": {
          "default": null,
          "description": "Four characters from r, g, b, a, 0, 1 (e.g. \"bgra\", \"rrr1\"); None = identity.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PartialColorSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/ColorContent"
        },
        "tag": {
          "$ref": "#/$defs/ColorTag"
        }
      },
      "type": "object"
    },
    "PartialEncoderSpec": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "bc1_transparent_black": {
          "type": "boolean"
        },
        "bc45_search_radius": {
          "$ref": "#/$defs/SearchRadius"
        },
        "effort": {
          "$ref": "#/$defs/Effort"
        },
        "perceptual": {
          "type": "boolean"
        },
        "rgbcx_level": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PartialFillSpec": {
      "additionalProperties": false,
      "description": "Global fill values for packed channels without a source map (spec §6.4, DECISIONS Notes H and M5): an 8-bit\ncode per §4.4 raw-map role, `None` = the neutral default. Unset fills are not serialised.",
      "properties": {
        "ao": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fuzz": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "glossiness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metallic": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "opacity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "roughness": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "specular": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PartialMipSpec": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageMode",
          "description": "Coverage preservation (spec §5.5). It only ever applies to the alpha-tested policies `cutout` and\n`cutout_blend`: `auto` and `on` both enable it there, `off` disables it, and on any other policy (`blend`,\n`data`, `remove`) every mode is a no-op, because blended alpha must keep box-averaged opacity."
        },
        "filter": {
          "$ref": "#/$defs/MipFilter"
        },
        "levels": {
          "$ref": "#/$defs/MipLevels"
        },
        "normal": {
          "$ref": "#/$defs/NormalMips"
        }
      },
      "type": "object"
    },
    "PartialPackingSpec": {
      "additionalProperties": false,
      "description": "Channel-packing settings (spec §3.2, §6.4). Fields of the packed output's profile, resolved like any other.",
      "properties": {
        "enabled": {
          "description": "Pack this output's recipe; `false` leaves its raw maps as packing inputs (`IN-PACKING-INPUT`).",
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/PartialFillSpec",
          "default": {}
        },
        "prefer": {
          "$ref": "#/$defs/PackPrefer",
          "description": "Which side wins when the set already holds the packed output as a file (`PACK-CONFLICT`)."
        },
        "recipe": {
          "$ref": "#/$defs/PackRecipe",
          "description": "Which cs recipe this set packs (`auto`, `rmaos`, `rfaos`; DECISIONS Note R-fills-1). Set per set at either packed key,\n`[files.\"<folder/base>_rfaos\"]` or `..._rmaos\"]`."
        },
        "roughness_default": {
          "description": "Neutral roughness (0..=1) for a channel without a roughness or glossiness source.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "PartialProfile": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/PartialAlphaSpec"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "channels": {
          "$ref": "#/$defs/PartialChannelSpec"
        },
        "color": {
          "$ref": "#/$defs/PartialColorSpec"
        },
        "encoder": {
          "$ref": "#/$defs/PartialEncoderSpec"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "header": {
          "$ref": "#/$defs/HeaderForm"
        },
        "mips": {
          "$ref": "#/$defs/PartialMipSpec"
        },
        "packing": {
          "$ref": "#/$defs/PartialPackingSpec"
        },
        "subtype": {
          "$ref": "#/$defs/Subtype"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "validation": {
          "$ref": "#/$defs/PartialValidationSpec"
        }
      },
      "type": "object"
    },
    "PartialValidationSpec": {
      "additionalProperties": false,
      "properties": {
        "bc6h_min_peak_ratio": {
          "format": "double",
          "type": "number"
        },
        "complex_m_warn_alpha": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "coverage_tolerance_pts": {
          "format": "double",
          "type": "number"
        },
        "min_mip_psnr_db": {
          "format": "double",
          "type": "number"
        },
        "pgpatcher_non_white_share": {
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "$ref": "#/$defs/AlphaSpec"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "channels": {
          "$ref": "#/$defs/ChannelSpec"
        },
        "color": {
          "$ref": "#/$defs/ColorSpec"
        },
        "encoder": {
          "$ref": "#/$defs/EncoderSpec"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "header": {
          "$ref": "#/$defs/HeaderForm"
        },
        "mips": {
          "$ref": "#/$defs/MipSpec"
        },
        "packing": {
          "$ref": "#/$defs/PackingSpec"
        },
        "subtype": {
          "$ref": "#/$defs/Subtype"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "validation": {
          "$ref": "#/$defs/ValidationSpec"
        }
      },
      "required": [
        "target",
        "category",
        "subtype",
        "color",
        "alpha",
        "channels",
        "mips",
        "format",
        "header",
        "encoder",
        "validation",
        "packing"
      ],
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/RuleMatch"
        },
        "overrides": {
          "$ref": "#/$defs/PartialProfile",
          "default": null
        },
        "subtype": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subtype"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "match"
      ],
      "type": "object"
    },
    "RuleMatch": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlphaContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "glob": {
          "default": null,
          "description": "Glob over the game-relative path (lower case, '/'), e.g. \"**/armor/**/*_n.png\".",
          "type": [
            "string",
            "null"
          ]
        },
        "set_has": {
          "default": null,
          "description": "The file's texture set contains a member with this suffix.",
          "type": [
            "string",
            "null"
          ]
        },
        "suffix": {
          "default": null,
          "description": "Recognised suffix without underscore, e.g. \"n\", \"rmaos\"; \"\" = no suffix.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SearchRadius": {
      "enum": [
        "default",
        "max"
      ],
      "type": "string"
    },
    "Subtype": {
      "enum": [
        "diffuse",
        "landscape_diffuse",
        "pbr_albedo",
        "pbr_emissive",
        "glow",
        "pbr_subsurface",
        "pbr_fuzz",
        "subsurface_tint",
        "backlight_tint",
        "ui_sky",
        "normal",
        "landscape_normal",
        "pbr_normal",
        "msn",
        "coat_normal",
        "envmask",
        "complex_material",
        "rmaos",
        "rfaos",
        "flow",
        "height",
        "msn_specular",
        "generic_two_channel",
        "generic_data",
        "hdr_sky"
      ],
      "type": "string"
    },
    "Target": {
      "enum": [
        "cs",
        "cpm",
        "vanilla"
      ],
      "type": "string"
    },
    "ValidationSpec": {
      "additionalProperties": false,
