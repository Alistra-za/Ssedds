        "pgpatcher_non_white_share": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min_mip_psnr_db",
        "coverage_tolerance_pts",
        "complex_m_warn_alpha",
        "bc6h_min_peak_ratio",
        "pgpatcher_non_white_share"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "defaults": {
      "$ref": "#/$defs/PartialProfile",
      "default": null
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "hidden": {
      "default": false,
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
