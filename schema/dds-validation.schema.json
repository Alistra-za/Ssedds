{
  "$defs": {
    "AlphaPolicy": {
      "enum": [
        "remove",
        "cutout",
        "blend",
        "cutout_blend",
        "data"
      ],
      "type": "string"
    },
    "AlphaStats": {
      "description": "Counts of decoded alpha values over one image.",
      "properties": {
        "below254": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eq254": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "eq255": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "min": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "pixels": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pixels",
        "eq255",
        "eq254",
        "below254",
        "min"
      ],
      "type": "object"
    },
    "Code": {
      "enum": [
        "LOSS-ALPHA-DATA",
        "LOSS-CLAMP-HDR",
        "LOSS-BITDEPTH",
        "LOSS-REENCODE",
        "CHAN-NOT-GRAY",
        "CHAN-CONSTANT-ALPHA-DATA",
        "CHAN-NORMAL-LENGTH",
        "CHAN-NORMAL-SHORT",
        "CHAN-AO-INVERTED",
        "CHAN-GLOSS-AS-ROUGH",
        "FMT-BC5-NORMAL",
        "FMT-LANDSCAPE-BC1",
        "FMT-BC1-ALPHA",
        "FMT-PERCEPTUAL-DATA",
        "FMT-HDR-SOURCE",
        "ALPHA-EXACT-OFF-M",
        "ALPHA-254",
        "ALPHA-NEAR-OPAQUE",
        "ALPHA-PBR-NORMAL-DROPPED",
        "TAG-SRGB-VANILLA",
        "TAG-SRGB-NONPBR",
        "TAG-UNORM-PBR",
        "TAG-SRGB-LOD",
        "TAG-CONTENT-MISMATCH",
        "CFG-UNAVAILABLE",
        "CFG-INVALID",
        "CFG-FILE-UNMATCHED",
        "CFG-FILTER-IGNORED",
        "CFG-PRESET-SKIPPED",
        "CFG-GREEN-CONFLICT",
        "DIM-NPOT",
        "DIM-SMALL",
        "DIM-FLOW-SMALL",
        "DIM-RESIZED",
        "DIM-TOO-LARGE",
        "SET-MISSING-COMPANION",
        "SET-COMPANION-OUTSIDE",
        "SET-COMPANION-DDS",
        "SET-BAKE-RATIO",
        "SET-EDIT-STALE",
        "SUG-LOW-CONFIDENCE",
        "SUG-CONTRADICTION",
        "VAL-ALPHA-GUARANTEE",
        "VAL-COVERAGE",
        "VAL-M-COMPLEX-MARGIN",
        "VAL-M-GRAYSCALE",
        "VAL-M-HEIGHT-CLIP",
        "VAL-PGPATCHER-50",
        "VAL-BC6H-PEAK",
        "VAL-HEADER",
        "VAL-MIP-ERROR",
        "ENC-NVTT-MISSING",
        "ENC-NVTT-VERSION",
        "ENC-NVTT-FAILED",
        "IN-DUPLICATE",
        "IN-DDS-SKIPPED",
        "IN-PACKING-INPUT",
        "IN-GREEN-UNSTATED",
        "IN-DECODE",
        "IN-NONFINITE",
        "IN-UNREADABLE",
        "IN-FLOAT-LDR",
        "IN-ICC-IGNORED",
        "IN-ALIAS-INVALID",
        "IN-ALIAS-STALE",
        "OUT-UNKNOWN-EXISTING",
        "PACK-DEFAULTED",
        "PACK-SIZE-MISMATCH",
        "PACK-CONFLICT",
        "PACK-UNUSED-INPUT",
        "PACK-RECIPE-CONFLICT",
        "PACK-RECIPE-UNBUILDABLE",
        "RNM-NO-BASE",
        "RNM-IGNORED-EYE",
        "RNM-MASK-ORPHAN",
        "RNM-AO-MISSING",
        "RNM-LAYER-SHADOWED",
        "SKIN-WET-FORM",
        "SHADER-AUTO",
        "SHADER-UNAVAILABLE",
        "SHADER-EXTRA-MAP",
        "SHADER-MISSING-MAP",
        "DDS-HEADER-PATCHED",
        "DDS-HEADER-UNPATCHABLE",
        "GRASS-SHAPE",
        "GRASS-TOP-OPAQUE",
        "GRASS-NORMALS",
        "GRASS-DETECT-SOURCE",
        "GRASS-VANILLA",
        "VAL-GRASS-DETECT"
      ],
      "type": "string"
    },
    "DdsValidationKind": {
      "description": "The `kind` of a `dds_validation` object.",
      "enum": [
        "dds_validation"
      ],
      "type": "string"
    },
    "DdsValidationUnreadable": {
      "properties": {
        "error": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DdsValidationKind"
        },
        "passed": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "readable": {
          "type": "boolean"
        },
        "schema": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "schema",
        "path",
        "readable",
        "passed",
        "error"
      ],
      "type": "object"
    },
    "DdsVerdict": {
      "properties": {
        "alpha_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlphaPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "The alpha policy it was judged by; null when the format was not judged."
        },
        "judged": {
          "description": "False for a format sdc never writes: only its header was checked.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/DdsValidationKind"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "readable": {
          "type": "boolean"
        },
        "schema": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "subtype": {
          "$ref": "#/$defs/Subtype",
          "description": "The sub-type the file was judged as (given or inferred)."
        },
        "summary": {
          "$ref": "#/$defs/ValidationSummary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "schema",
        "path",
        "readable",
        "subtype",
        "judged",
        "passed",
        "summary",
        "warnings"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "blocking",
        "error"
      ],
      "type": "string"
    },
    "Subtype": {
      "description": "A texture sub-type. `rfaos` is a deprecated alias of `skin_rfaos`: it still loads and is written back as `skin_rfaos`.",
      "enum": [
        "diffuse",
        "landscape_diffuse",
        "pbr_albedo",
        "pbr_emissive",
        "glow",
        "pbr_subsurface",
        "pbr_fuzz",
        "subsurface_tint",
        "backlight_tint",
        "ui_sky",
        "normal",
        "landscape_normal",
        "pbr_normal",
        "msn",
        "coat_normal",
        "envmask",
        "complex_material",
        "rmaos",
        "skin_rfaos",
        "flow",
        "height",
        "msn_specular",
        "generic_two_channel",
        "generic_data",
        "hdr_sky",
        "skin_albedo",
        "skin_sk",
        "skin_wet",
        "complex_grass",
        "rfaos"
      ],
      "type": "string"
    },
    "ValidationSummary": {
      "properties": {
        "alpha": {
          "description": "Decoded-alpha statistics per level, for formats that carry alpha (BC1, BC3, BC7).",
          "items": {
            "$ref": "#/$defs/AlphaStats"
          },
          "type": "array"
        },
        "bc6h_peak_ratio": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "coverage": {
          "description": "Decoded coverage per level; filled only when the coverage check ran.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "levels": {
          "description": "The header's mip count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "min_mip_psnr_db": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "passed": {
          "description": "No `Error`-severity warning.",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "levels",
        "alpha",
        "coverage"
      ],
      "type": "object"
    },
    "Warning": {
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "data": {
          "default": null
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DdsVerdict"
    },
    {
      "$ref": "#/$defs/DdsValidationUnreadable"
    }
  ],
  "description": "`sdc validate` on one file: the spec §5.8 verdict, or why the file cannot be read.",
  "title": "DdsValidation"
}
