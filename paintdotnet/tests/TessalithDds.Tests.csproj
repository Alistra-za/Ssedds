<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tessalith.Dds.Tests</RootNamespace>
    <PsddsDll Condition="'$(PsddsDll)' == ''">$(MSBuildThisFileDirectory)..\..\target\psdds\x86_64-pc-windows-msvc\release\psdds.dll</PsddsDll>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\src\Core\*.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <None Include="$(PsddsDll)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(PsddsDll)')" />
  </ItemGroup>
</Project>