<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TessalithDds</AssemblyName>
    <RootNamespace>Tessalith.Dds</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PdnDir Condition="'$(PdnDir)' == '' and '$(PDN_DIR)' != ''">$(PDN_DIR)</PdnDir>
    <PdnDir Condition="'$(PdnDir)' == ''">C:\Program Files\paint.net</PdnDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <!-- Build-time only: Paint.NET's DLLs are never copied (Private=false). -->
    <Reference Include="PaintDotNet.Base;PaintDotNet.Core;PaintDotNet.ComponentModel;PaintDotNet.Data;PaintDotNet.Fundamentals;PaintDotNet.Primitives;PaintDotNet.ObjectModel;PaintDotNet.Windows">
      <HintPath>$(PdnDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>